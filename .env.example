# Copy to .env (git-ignored) and fill in; never commit real values. The training
# launchers, the evaluation runners (Sherpa, MathTutorBench) and prepare_data.py
# read .env (variables already set in the environment win). Use EMPTY as the key
# of an unauthenticated local server.
#
# Training needs none of these: the launchers serve the student locally and use
# the rollout model as the judge.

# Teacher, student and judge servers for evaluation (examples/sherpa/eval,
# examples/math_tutor_bench, prepare_data.py filter).
TEACHER_BASE_URL=http://127.0.0.1:30000/v1
TEACHER_API_KEY=EMPTY
STUDENT_BASE_URL=http://127.0.0.1:30001/v1
STUDENT_API_KEY=EMPTY
AUX_BASE_URL=http://127.0.0.1:30002/v1
AUX_API_KEY=EMPTY
# Adapter to evaluate, as registered on the teacher server (extra_body.lora_path).
# TEACHER_ADAPTER=/path/to/checkpoint

# Optional: a prepared dataset other than the default filtered MATH split.
# SHERPA_DATASET=/path/to/dataset

# Commercial API teachers (configs with a `provider`).
GEMINI_BASE_URL=
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional standard proxy settings.
# HTTPS_PROXY=
# NO_PROXY=127.0.0.1,localhost
